# ---- Project runtime artifacts ----------------------------------------------
# Precompute output (built by training/precompute_training.py).
cache/
# Wandb local run dir (created by `wandb.init`).
wandb/
# Default inference output (inference.py writes ./output.mp4).
output.mp4

# Catch-all defense: model weights, video frames, raw tensors. Tracked
# exceptions are whitelisted via per-dir .gitignore (e.g. models/hed_config/).
*.pt
*.safetensors
*.npy
*.mp4

# ---- Slurm logs -------------------------------------------------------------
slurm-*.out
slurm-*.err